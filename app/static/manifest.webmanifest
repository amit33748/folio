{
  "name": "Folio — document workshop",
  "short_name": "Folio",
  "description": "Edit PDFs in their original font, convert anything to Markdown, resize photos to an exact KB, and 90+ more file tools.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f6f1e7",
  "theme_color": "#f6f1e7",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Edit PDF", "url": "/#/tool/edit-pdf", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan to PDF", "url": "/#/tool/scan-to-pdf", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Compress image to KB", "url": "/#/tool/image-to-size", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Anything to Markdown", "url": "/#/tool/any-to-markdown", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["application/pdf", "image/*", "video/*", "audio/*", ".docx", ".doc", ".xlsx", ".xls", ".pptx", ".ppt", ".epub", ".md", ".txt", ".csv", ".zip"] }
      ]
    }
  }
}
